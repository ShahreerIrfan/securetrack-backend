# Copy to .env for local overrides, or set these directly as environment
# variables in Dokploy. Nothing here is read at Docker build time - all of
# it is picked up by entrypoint.sh / settings.py at container start.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# "True"/"False" - must be False in every deployed environment.
DJANGO_DEBUG=False

# Comma-separated, no scheme/port - the domain(s) this API is served from.
DJANGO_ALLOWED_HOSTS=api.yourdomain.com

# Dokploy's managed Postgres connection string (or any standard DB URL).
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/securetrack

# Comma-separated, full origin(s) (with scheme, no trailing slash) of the
# frontend(s) allowed to call this API.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Comma-separated, full origin(s) - only needed if you use Django admin
# behind HTTPS; safe to set to the same value as CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Optional - gunicorn tuning, sane defaults are baked into entrypoint.sh.
# PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
